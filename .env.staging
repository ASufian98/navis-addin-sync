# BINA Navis Sync — STAGING (Staging builds embed this)
# UAT builds against the staging backend.

# BINA Cloud API (bina-be)
API_BASE_URL=https://api-stg.binacloud.ai

# OTA update feed (version.json). Empty = updater disabled for staging.
# Staging builds should not auto-update to avoid polluting test environments.
UPDATE_FEED_URL=

# Web origin for login flow
CLOUD_WEB_URL=https://app-stg.binacloud.ai
