# BINA Navis Sync — PRODUCTION (Release builds embed this)
# Fleet builds against the production backend.

# BINA Cloud API (bina-be)
API_BASE_URL=https://api.binacloud.ai

# OTA update feed (version.json). Points at GitHub releases.
UPDATE_FEED_URL=https://github.com/binacloudmy/navis-addin-sync/releases/latest/download/version.json

# Web origin for login flow
CLOUD_WEB_URL=https://app.binacloud.ai
